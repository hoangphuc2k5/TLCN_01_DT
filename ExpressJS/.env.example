NODE_ENV=development
PORT=8080

# Tên dự án — đổi 1 chỗ này là đổi toàn hệ thống (UI, email, API)
APP_NAME=EduMoet

# MongoDB — local hoặc Atlas (điền URI thật chỉ trong .env, không commit)
# MONGO_DB_URL=mongodb://localhost:27017/school_management
MONGO_DB_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/school_management?retryWrites=true&w=majority

JWT_SECRET=change_me
JWT_EXPIRE=1d

# Google OAuth (Web Client) — KHÔNG commit giá trị thật
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

AUTH_GMAIL_ONLY=true
ALLOW_PASSWORD_LOGIN=true

GMAIL_USER=
GMAIL_APP_PASSWORD=

# 32 random bytes encoded as 64 hex characters; keep stable and back up separately.
# Empty disables new 2FA enrollment; existing 2FA accounts still require their factor.
AUTH_MFA_ENCRYPTION_KEY=

# Operator-only encrypted backup/restore. Never use live DB/files as restore targets.
BACKUP_ENCRYPTION_KEY=
BACKUP_STAGING_ROOT=
BACKUP_MAX_BYTES=10737418240
RESTORE_DB_URL=
RESTORE_JWT_SECRET=
RESTORE_MFA_ENCRYPTION_KEY=

FRONTEND_URL=http://localhost:5173

# Private file storage. Upload/delete requires MongoDB replica set (Atlas or local replica set).
FILE_STORAGE_DRIVER=local
# Default: ExpressJS/storage/private; use an absolute path for deployment.
FILE_LOCAL_ROOT=
FILE_MAX_BYTES=10485760
# Used when the school has no active, unexpired subscription; active plans use storageGb.
FILE_DEFAULT_QUOTA_BYTES=5368709120
FILE_S3_BUCKET=
FILE_S3_ENDPOINT=
FILE_S3_FORCE_PATH_STYLE=false
AWS_REGION=us-east-1
# S3 credentials use the standard AWS credential chain/IAM role; never commit real keys.

# Start worker separately with npm run worker; no worker is started by the API.
JOB_POLL_MS=2000
JOB_LEASE_MS=90000
JOB_MAX_ATTEMPTS=5
JOB_RETRY_MS=5000
JOB_FILE_DELETE_GRACE_MS=30000
