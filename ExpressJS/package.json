{
  "name": "school-management-api",
  "version": "1.0.0",
  "description": "Multi-tenant School Management System API (MERN)",
  "main": "src/server.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "nodemon ./src/server.js",
    "start": "node ./src/server.js",
    "worker": "node scripts/job-worker.js",
    "backup": "node scripts/backup.js",
    "seed": "node ./src/config/seed/seed.config.js",
    "fixture:vnpay-sandbox": "node scripts/vnpay-sandbox-fixture.js",
    "lint": "eslint src --max-warnings 120",
    "test": "node --test --test-concurrency=1",
    "test:coverage": "node --experimental-test-coverage --test --test-concurrency=1 --test-coverage-lines=83 --test-coverage-branches=78 --test-coverage-functions=80"
  },
  "keywords": [
    "nodejs",
    "expressjs",
    "mongodb",
    "multi-tenant",
    "school"
  ],
  "author": "Khoa Luan",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "docx": "^9.7.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.3.2",
    "google-auth-library": "^11.0.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.2",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "nodemailer": "^10.2.1",
    "otpauth": "^9.5.2",
    "pdfkit": "^0.20.2",
    "ws": "^8.21.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "mongodb-memory-server": "^10.1.4",
    "nodemon": "^3.1.4"
  },
  "overrides": {
    "qs": "^6.16.1"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "mongodb-memory-server@10.1.4": true
  }
}
